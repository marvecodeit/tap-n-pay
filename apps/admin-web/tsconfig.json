{
  "extends": "@tapnpay/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@tapnpay/ui": ["../../packages/ui/src/index.ts"],
      "@tapnpay/api-client": ["../../packages/api-client/src/index.ts"]
    }
  },
  "include": ["src"]
}
