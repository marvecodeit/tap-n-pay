{
  "name": "tapnpay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "corepack pnpm --filter=@tapnpay/admin-web --filter=@tapnpay/student-web --filter=@tapnpay/terminal-pwa --filter=@tapnpay/landing-pages --parallel run dev",
    "dev:apps": "corepack pnpm --filter=@tapnpay/admin-web --filter=@tapnpay/student-web --filter=@tapnpay/terminal-pwa --filter=@tapnpay/landing-pages --parallel run dev",
    "dev:admin": "corepack pnpm --filter=@tapnpay/admin-web run dev",
    "dev:student": "corepack pnpm --filter=@tapnpay/student-web --filter=@tapnpay/landing-pages --parallel run dev",
    "dev:terminal": "corepack pnpm --filter=@tapnpay/terminal-pwa run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
